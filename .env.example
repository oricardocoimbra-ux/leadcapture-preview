# LeadCapture — Variáveis de Ambiente (Exemplo)
# Copiar para .env.local e preencher com credenciais reais. Nunca commitar segredos.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth & Database (OAuth Google + Email/Password)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Envio de formulários apenas por email (Brevo — mantido desativado por defeito)
FORMS_ENABLED=false
FORMS_TO_EMAIL=geral@leadcapture.cloud
FORMS_FROM_EMAIL=geral@leadcapture.cloud
FORMS_FROM_NAME=LeadCapture
BREVO_API_KEY=
# Opcional — anti-spam Cloudflare Turnstile (ativado automaticamente se definido)
TURNSTILE_SECRET_KEY=

